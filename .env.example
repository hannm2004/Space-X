# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG push file .env.
MYSQL_ROOT_PASSWORD=doi_mat_khau_nay
MYSQL_DATABASE=spacex
MYSQL_USER=spacex
MYSQL_PASSWORD=doi_mat_khau_nay
# Kết nối của ứng dụng Spring Boot. Ở máy trỏ vào MySQL của docker compose:
# DB_USERNAME phải trùng MYSQL_USER, DB_PASSWORD trùng MYSQL_PASSWORD, tên database trong DB_URL trùng MYSQL_DATABASE.
# Trên Render dùng thông tin Aiven, URL phải có ?sslMode=REQUIRED (Aiven bắt buộc TLS).
DB_URL=jdbc:mysql://127.0.0.1:3306/spacex
DB_USERNAME=spacex
DB_PASSWORD=doi_mat_khau_nay
# ADMIN đầu tiên, tạo khi khởi động nếu chưa có ADMIN nào (D26). Đặt cả hai hoặc để trống cả hai.
# Mật khẩu từ 8 ký tự đến 72 byte. Email đã thuộc học sinh thì ứng dụng không khởi động. Trên Render đặt trong Environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=
